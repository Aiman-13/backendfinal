<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Feedback Form</title>
	<link rel="stylesheet" type="text/css" href="css/style.css">
	<link rel="stylesheet" type="text/css" href="css/feedback.css">
</head>
<body>
	<div class="main">
		<%- include('partials/header') %>
	</div>
	<section class="feedback-section">
		<div class="container">
			<div class="feedback-card">
				<h2 class="feedback-title">We value your feedback</h2>
				<p class="feedback-sub">Tell us about your experience — your input helps us improve.</p>
				<form name="feedbackForm" class="feedback-form" method="get" action="/feed">
					<div class="row">
						<div class="col">
							<label for="uname">Your Name</label>
							<input type="text" name="uname" id="uname" class="input" placeholder="Your Name" required>
						</div>
						<div class="col">
							<label for="txtemail">Your Email</label>
							<input type="email" name="txtemail" id="txtemail" class="input" placeholder="Your Email" required>
						</div>
					</div>
					<div class="row">
						<div class="col-full">
							<label for="feedback">Feedback</label>
							<textarea name="feedback" id="feedback" class="textarea" rows="6" placeholder="Please write your feedback here" required></textarea>
						</div>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn-submit" name="submit">Send Feedback</button>
					</div>
				</form>
			</div>
		</div>
	</section>
</body>
</html>